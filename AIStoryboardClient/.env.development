# 开发环境：Vite 代理将 /api 转发到 API Gateway localhost:8080，前端使用相对路径即可
VITE_API_BASE_URL=

# 画布前端（XiaoYueCanvasAgent）开发地址：vite.config.ts base=/canvas/，端口 3000。
# 不配置时 /chat 的画布按钮会退化为同源 /canvas 相对路径（iframe 落在聊天端口上）。
VITE_CANVAS_URL=http://localhost:3000/canvas

# 语音识别 vosk-server WebSocket 地址（前端直连；生产改为内网 vosk 地址）
VITE_VOSK_WS_URL=ws://localhost:2700
