# ═══════════════════════════════════════════════════════════
#  AI Storyboard 后端环境变量模板
#  复制为 .env 并填入真实值（.env 不会被提交到 Git）
#
#  本地开发提示：
#  推荐使用 application-local.yml 代替 .env，
#  前者支持 Spring profile 且已在 .gitignore 中。
#  StoryboardApplication 会在启动时读取 .env 文件，
#  并通过 System.setProperty() 注入（仅当同名属性未设置时）。
# ═══════════════════════════════════════════════════════════

# ── 数据库（PostgreSQL）──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=newworkflow
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# ── JWT 签名密钥（至少 256 位，生产环境务必更换）──
JWT_ACCESS_SECRET=your-access-secret-min-256-bits
JWT_REFRESH_SECRET=your-refresh-secret-min-256-bits

# ── Laozhang API 密钥 ──
LAOZHANG_API_KEY=«redacted:sk-…»
LAOZHANG_SORA2_API_KEY=«redacted:sk-…»

# ── LLM 网关（AILLMGateway，视频创建/轮询/下载走网关代理）──
LLM_GATEWAY_BASE_URL=http://localhost:8083
LLM_GATEWAY_API_KEY=lg-<在网关 /admin 创建的业务 Key>

# ── 可选 ──
# SERVER_PORT=8082
# JWT_ISSUER=newworkflow-backend