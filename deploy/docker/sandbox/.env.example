# MoonAgent shared sandbox deployment settings.
#
# Copy this file to .env before starting the Compose project:
#   cp .env.example .env
#
# SANDBOX_INTERNAL_SECRET is required by the runner and must be changed
# outside local development.

COMPOSE_PROJECT_NAME=moon-sandbox
MOON_SANDBOX_IMAGE_TAG=local

# The runner process and the /workspaces volume use this identity.
MOON_SANDBOX_UID=10001
MOON_SANDBOX_GID=10001

# The runner is published on loopback by default. Put a network address here
# only when MoonAgent connects from another host.
SANDBOX_BIND_IP=127.0.0.1
SANDBOX_PORT=8090
SANDBOX_INTERNAL_SECRET=change-me-in-production

SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPUS=2.0
SANDBOX_PIDS_LIMIT=256
SANDBOX_TMP_SIZE=512m
SANDBOX_STOP_GRACE_PERIOD=30s
SANDBOX_DEFAULT_TIMEOUT_SECONDS=300
SANDBOX_MAX_TIMEOUT_SECONDS=600
SANDBOX_MAX_CONCURRENT_EXECUTIONS=4
SANDBOX_IDLE_EXPIRY=24h

# Space- or comma-separated Squid dstdomain entries. A leading dot permits
# subdomains. Keep this list limited to package mirrors and tools the runner
# actually needs.
SANDBOX_ALLOWED_DOMAINS=.pypi.org .files.pythonhosted.org .pythonhosted.org pypi.org files.pythonhosted.org

SANDBOX_PROXY_MEMORY_LIMIT=256m
SANDBOX_PROXY_CPUS=0.5
SANDBOX_PROXY_PIDS_LIMIT=128
SANDBOX_PROXY_TMP_SIZE=64m

# Named volume for session work/output/vendor directories.
SANDBOX_WORKSPACES_VOLUME=sandbox-workspaces
