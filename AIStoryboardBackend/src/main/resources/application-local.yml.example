# application-local.yml.example — 复制为 application-local.yml 并填入真实值
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/ai_storyboard
    username: postgres
    password: <your-password>
  ai:
    openai:
      base-url: http://localhost:8083/v1
      api-key: <your-gateway-api-key>

jwt:
  access-secret: <random-32char-hex>
  refresh-secret: <random-32char-hex>

ai:
  gateway:
    base-url: http://localhost:8083
    api-key: <your-gateway-api-key>

# 内部服务共享密钥（必填，无默认值；缺失会导致启动失败）
# 可由环境变量 INTERNAL_SECRET 注入，或在此填入与 MoonAgent/ApiGateway 一致的值
internal:
  secret: <shared-secret>

storyboard:
  storage:
    endpoint: http://localhost:9000
    access-key: <your-minio-access-key>
    secret-key: <your-minio-secret-key>
    bucket: storyboard
    region: us-east-1

# 本地开发走 HTTP，生产必须保持 true
auth:
  cookie:
    secure: false
