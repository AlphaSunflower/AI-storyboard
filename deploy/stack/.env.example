# AI-storyboard unified stack config (copy to .env and adjust if needed)
# 说明：所有密钥与当前开发环境保持一致，本文件只做占位示例。

COMPOSE_PROJECT_NAME=aistoryboard
IMAGE_TAG=canvas-mailbox-20261013

# 入口与端口
FRONTEND_PORT=80
POSTGRES_PORT=5433
GATEWAY_PORT=8083
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379
SANDBOX_PORT=8090

# 服务发现：默认关闭（不注册、不发现），ApiGateway 按下面四个直连地址路由。
# 恢复 Nacos 注册发现：NACOS_DISCOVERY_ENABLED=true，四个 *_URI 改成
# lb://moon-agent / lb://asset-service / lb://xiaoyue-canvas / lb://ai-storyboard，
# 并按 deploy/docker/nacos 单独起 Nacos（NACOS_ADDR 默认 nacos:8848）。
NACOS_DISCOVERY_ENABLED=false
NACOS_ADDR=nacos:8848
BACKEND_URI=http://backend:8082
ASSET_SERVICE_URI=http://asset-service:8085
CANVAS_URI=http://canvas:9090
MOON_AGENT_URI=http://moon-agent:8084

# 数据库（容器内新库）
POSTGRES_PASSWORD=123456

# 对象存储（与现有 minio/data 内的凭据保持一致，不要改）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# 主后端 / 网关共享
INTERNAL_SECRET=2b25cb017d3c696eaeb2ab3cfc2b94fd9990e7e52656e3119dc8a75097be0709
JWT_ACCESS_SECRET=d02f1779750841f8b4de65e47a913e89
JWT_REFRESH_SECRET=cd311f4121c24cf8b761775f9dafae78
JWT_ISSUER=ai-storyboard-backend
AUTH_COOKIE_SECURE=false

# LLM 网关自举与加密（llm_gateway prod 配置现值）
GATEWAY_JWT_ACCESS_SECRET=419d1b039610f22bfcd98ae4e57633953a6df1cae00729e0
GATEWAY_JWT_REFRESH_SECRET=68ba475a58635df0d0cc4dd28321ea0434a1e868a32ced16
GATEWAY_AES_SECRET=49ecf66b9167579710c1f46567260a94
GATEWAY_ADMIN_INIT_PASSWORD=admin-init-9d2d14c37360be40

# 应用调用网关的 key（与 llm_gateway.gateway_api_key 表内一致）
LLM_GATEWAY_API_KEY_MAIN=lg-5f018f73b71c4bda8b9ebb97268d55a9
LLM_GATEWAY_API_KEY_AGENT=lg-df377c8084e645ffa34e0dfce1fb3e78

# Agent 联网检索：默认自托管 SearXNG（无第三方 key、无按次计费）
# 前提：SearXNG 实例的 settings.yml 开了 json 输出 —— search: formats: [html, json]
# 该容器由本 compose 提供（统一栈内服务名 searxng，与独立部署的 deploy/docker/searxng 同一个配置）
# SEARXNG_SECRET 必填且不要用示例值：生成 openssl rand -hex 32
SEARXNG_SECRET=a17667b66703cbfa367c227d28141f41ccf02a25c503054d9637c8c31aedcd45
AGENTSCOPE_WEB_SEARCH_PROVIDER=searxng
AGENTSCOPE_SEARXNG_URL=http://searxng:8080
# 改用 DeepSeek 原生搜索（服务端执行、按账号计费）时：provider=deepseek 并填下面这把 key
AGENTSCOPE_WEB_SEARCH_API_KEY=
# AGENTSCOPE_WEB_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
# AGENTSCOPE_WEB_SEARCH_MODEL=deepseek-v4-flash

# 画布 MCP：XiaoYueCanvas 同时提供 canvas_graph_* 与 canvas_execute_*（浏览器执行信箱）
MORROW_CANVAS_SERVER_URL=http://canvas:9090

# MoonSandbox 共享密钥（runner 与 moon-agent 必须一致）
SANDBOX_INTERNAL_SECRET=local-moon-sandbox-secret
SANDBOX_ALLOWED_DOMAINS=.pypi.org .pythonhosted.org

# 应用网络与 moon-agent 的固定地址（它同时接入沙箱网络，
# 固定 IP 保证直连路由与连接池地址在容器重建后不变）
APP_NETWORK_SUBNET=172.28.0.0/24
MOON_AGENT_REGISTER_IP=172.28.0.14
