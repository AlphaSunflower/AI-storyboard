# deploy/docker/searxng/.env.example
# 复制为 .env 后再改；.env 里不要提交任何真实密钥。
#   cp .env.example .env

# 必需：SearXNG 的会话签名密钥（不要用示例值）
# 生成：openssl rand -hex 32
SEARXNG_SECRET=change-me-openssl-rand-hex-32

# 监听地址与端口。只绑 127.0.0.1：MoonAgent 与它同机（或同 compose 网络）时无需对外暴露。
# 跨机器部署时设为内网 IP，并在 SearXNG 前面自行加认证与防火墙规则。
SEARXNG_BIND_IP=127.0.0.1
SEARXNG_PORT=8888

# 实例外部地址（影响搜索结果里的自引用链接，按实际访问地址填）
SEARXNG_BASE_URL=http://localhost:8888/
