{
  "schemaVersion": 1,
  "servers": [
    {
      "name": "llm-gateway-media",
      "version": "1.0.0",
      "description": "LLM Gateway media tools consumed by MoonAgent through streamable HTTP MCP.",
      "protocol": "mcp-streamable",
      "endpoint": {
        "type": "DIRECT",
        "data": {
          "address": "${MCP_GATEWAY_ADDRESS}",
          "port": "${MCP_GATEWAY_PORT}",
          "transportProtocol": "streamable-http"
        }
      },
      "tools": [
        {
          "name": "generate_image",
          "description": "Generate or edit images through the LLM Gateway.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "TEXT_TO_IMAGE",
                  "IMAGE_EDIT"
                ],
                "description": "TEXT_TO_IMAGE or IMAGE_EDIT"
              },
              "prompt": {
                "type": "string",
                "description": "Image generation or edit prompt"
              },
              "sourceImages": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Source image URLs or data URIs"
              },
              "model": {
                "type": "string",
                "description": "Optional model"
              },
              "size": {
                "type": "string",
                "description": "Optional image size"
              },
              "quality": {
                "type": "string",
                "description": "Optional image quality"
              },
              "n": {
                "type": "integer",
                "description": "Number of images"
              },
              "negativePrompt": {
                "type": "string",
                "description": "Optional negative prompt"
              },
              "projectId": {
                "type": "string",
                "description": "Project ID"
              },
              "conversationId": {
                "type": "string",
                "description": "Conversation ID"
              },
              "idempotencyKey": {
                "type": "string",
                "description": "Idempotency key"
              }
            },
            "required": [
              "prompt"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "generate_video",
          "description": "Generate a video through the LLM Gateway.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string",
                "description": "Video prompt"
              },
              "referenceImages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "FIRST_FRAME",
                        "LAST_FRAME",
                        "REFERENCE"
                      ]
                    }
                  },
                  "required": [
                    "url",
                    "role"
                  ],
                  "additionalProperties": false
                },
                "description": "Reference images"
              },
              "model": {
                "type": "string",
                "description": "Optional model"
              },
              "duration": {
                "type": "integer",
                "description": "Duration in seconds"
              },
              "aspectRatio": {
                "type": "string",
                "description": "Aspect ratio"
              },
              "resolution": {
                "type": "string",
                "description": "Resolution"
              },
              "size": {
                "type": "string",
                "description": "Optional size"
              },
              "negativePrompt": {
                "type": "string",
                "description": "Optional negative prompt"
              },
              "seed": {
                "type": "integer",
                "description": "Optional seed"
              },
              "imageUrl": {
                "type": "string",
                "description": "Optional first-frame image URL"
              },
              "referenceVideos": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Optional reference video URLs"
              },
              "referenceAudios": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Optional reference audio URLs"
              },
              "projectId": {
                "type": "string",
                "description": "Project ID"
              },
              "conversationId": {
                "type": "string",
                "description": "Conversation ID"
              },
              "idempotencyKey": {
                "type": "string",
                "description": "Idempotency key"
              }
            },
            "required": [
              "prompt"
            ],
            "additionalProperties": false
          }
        }
      ]
    }
  ]
}
