# ── deploy/allinone 单 JVM 全栈配置（2 核 2G 公网测试）────────────────────
# 这些密钥与 deploy/stack/.env、以及 db/*.dump 里 llm_gateway.gateway_api_key 表的值必须一致，
# 改动 LLM_GATEWAY_API_KEY_* 就必须同步改库里的 key，否则服务调用网关会 401。

COMPOSE_PROJECT_NAME=aistoryboard-lite
# 容器名前缀，避免和同一台机器上别的栈撞名
STACK_PREFIX=ai-lite
IMAGE_TAG=lite-20261015
# allinone 镜像的基座（带 ffmpeg，长视频拼接要用）。
# 想换更小的镜像：改成 aistoryboard/java-base:<tag> 重新 build-images（省约 600MB，但拼视频不可用）
BASE_IMAGE=aistoryboard/java-base-ffmpeg:canvas-mailbox-20261013

# ── 对外入口：公网 IP + 80 ──────────────────────────────────────────────
HTTP_BIND_IP=0.0.0.0
HTTP_PORT=80
# ⚠️ 上线必改：浏览器地址栏里实际访问这个站点的地址（含协议，带端口就带端口）
# 为什么必须改：浏览器对 POST/PATCH/PUT 会带 Origin 头，canvas 服务会做 CORS 校验；
# 这里跟实际访问地址不一致时，画布的保存 / 重命名 / 信箱注册会被**静默 403**
# （响应体是 "Invalid CORS request"，日志里没有任何痕迹，极难排查）。
# 例：PUBLIC_ORIGIN=http://122.51.12.200  或  https://your.domain
PUBLIC_ORIGIN=http://localhost

# ── 只绑本机回环的运维端口（公网不可达）──────────────────────────────
POSTGRES_PORT=5433
REDIS_PORT=6379
GATEWAY_PORT=8083
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
SANDBOX_PORT=8090

# ── 数据库 ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# ── 账号（只能有两个：admin@qq.com + 第二个）───────────────────────────
# 两个账号都用密码 123456；第二个账号在首次初始化数据卷时创建/重置（db/05-two-accounts.sh）。
# 注册接口在入口 nginx 被拦成 403，后端注册代码未改动。
SECOND_ACCOUNT_EMAIL=test@qq.com
SECOND_ACCOUNT_NAME=测试用户

# ── 对象存储（必须与已有 minio 对象数据的凭据一致）────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ── 主后端 / 网关共享密钥 ──────────────────────────────────────────────
INTERNAL_SECRET=2b25cb017d3c696eaeb2ab3cfc2b94fd9990e7e52656e3119dc8a75097be0709
JWT_ACCESS_SECRET=d02f1779750841f8b4de65e47a913e89
JWT_REFRESH_SECRET=cd311f4121c24cf8b761775f9dafae78
JWT_ISSUER=ai-storyboard-backend
AUTH_COOKIE_SECURE=false

# ── LLM 网关自举与加密 ─────────────────────────────────────────────────
GATEWAY_JWT_ACCESS_SECRET=419d1b039610f22bfcd98ae4e57633953a6df1cae00729e0
GATEWAY_JWT_REFRESH_SECRET=68ba475a58635df0d0cc4dd28321ea0434a1e868a32ced16
GATEWAY_AES_SECRET=49ecf66b9167579710c1f46567260a94
GATEWAY_ADMIN_INIT_PASSWORD=admin-init-9d2d14c37360be40

# ── 业务侧调用 LLM 网关的 key（与 llm_gateway.gateway_api_key 表一致）──
LLM_GATEWAY_API_KEY_MAIN=lg-5f018f73b71c4bda8b9ebb97268d55a9
LLM_GATEWAY_API_KEY_AGENT=lg-df377c8084e645ffa34e0dfce1fb3e78

# ── MoonSandbox（可选 profile；默认关闭）──────────────────────────────
AGENT_SANDBOX_ENABLED=false
SANDBOX_INTERNAL_SECRET=local-moon-sandbox-secret
SANDBOX_ALLOWED_DOMAINS=.pypi.org .pythonhosted.org
SANDBOX_IMAGE_TAG=lite

# ── 单 JVM 内存预算（2G 机器默认值；机器升配就调大这两个数）────────────
# 实测（6 个上下文全部启动完成、空闲态）：JVM RSS ≈ 1.15G，
#   其中堆稳定在 ~240M（Xmx 768M）、Metaspace 实际 ~430M（上限给 512M）。
# 整栈实测 ≈ 1.35G（不含 sandbox），2G 机器请务必配 4G swap。
ALLINONE_MEM_LIMIT=1500m
ALLINONE_CPUS=2.0
JVM_XMX=768m
JVM_METASPACE=512m
JVM_CODE_CACHE=128m
# 例如想开 C1-only 省 CPU/代码缓存：-XX:TieredStopAtLevel=1
JVM_EXTRA_OPTS=

# ── 其它容器资源上限（2 核 2G 下必须都压住）───────────────────────────
POSTGRES_MEM_LIMIT=384m
POSTGRES_CPUS=1.0
REDIS_MEM_LIMIT=192m
REDIS_CPUS=0.5
MINIO_MEM_LIMIT=384m
MINIO_CPUS=0.5
FRONTEND_MEM_LIMIT=64m
FRONTEND_CPUS=0.5
SANDBOX_MEM_LIMIT=384m
SANDBOX_CPUS=1.0
SANDBOX_PROXY_MEM_LIMIT=192m
SANDBOX_PROXY_CPUS=0.25

TZ=Asia/Shanghai
