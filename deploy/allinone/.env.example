# ── deploy/allinone 单 JVM 全栈配置（全量数据版，2 核 2G 云服务器）─────────
# 复制为 .env 后按注释修改。密钥必须与 db/*.dump 里 llm_gateway.gateway_api_key 表一致，
# 否则业务侧调用模型网关会 401。
#
# 数据口径：本地全量导出（157 账号 / 168 项目 / 376 会话 / 677 Agent 资产 /
# 2087 个 MinIO 对象文件）。admin@qq.com 由 771038325@qq.com 原地改名，其余账号一行不删。
# 首次启动必须使用空数据卷（全新 STACK_PREFIX），否则 Postgres 不会执行 db/ 初始化脚本。

COMPOSE_PROJECT_NAME=aistoryboard-cloud
# 容器名前缀：与旧栈 ai-lite 区分，旧栈的卷/数据目录不会被覆盖，可随时回滚
STACK_PREFIX=ai-cloud
IMAGE_TAG=cloud-20261021
# 沙箱由 scripts/load-and-up.sh 默认带 --profile sandbox 拉起；直接 docker compose 请加 --profile sandbox。
# 不想开沙箱：WITH_SANDBOX=0 bash scripts/load-and-up.sh（不再拉 sandbox 服务）。
# allinone 镜像基座（带 ffmpeg，长视频拼接要用）
BASE_IMAGE=aistoryboard/java-base-ffmpeg:canvas-mailbox-20261013

# ── 对外入口 ───────────────────────────────────────────────────────────
HTTP_BIND_IP=0.0.0.0
HTTP_PORT=80
# ⚠️ 必改：浏览器实际访问地址（含协议与端口）。与这里不一致时，画布保存/重命名会静默 403。
PUBLIC_ORIGIN=http://YOUR_SERVER_IP

# ── 只绑本机回环的运维端口（公网不可达）──────────────────────────────
POSTGRES_PORT=5433
REDIS_PORT=6379
GATEWAY_PORT=8083
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
SANDBOX_PORT=8090

# ── 数据库 ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# ── 账号（全量保留，不收敛）────────────────────────────────────────────
# 只确保 admin@qq.com / 123456 可登录（由 771038325@qq.com 原地改名）。
# 其余 156 个账号及其项目/会话/资产全部保留；db/03-init-admin.sh 不做任何删除。

# ── 对象存储（必须与包内 data/minio 的凭据一致）────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_DATA_DIR=./data/minio

# ── 主后端 / 网关共享密钥 ──────────────────────────────────────────────
INTERNAL_SECRET=change-me-internal
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ISSUER=ai-storyboard-backend
AUTH_COOKIE_SECURE=false

# ── LLM 网关自举与加密 ─────────────────────────────────────────────────
GATEWAY_JWT_ACCESS_SECRET=change-me-gateway-access
GATEWAY_JWT_REFRESH_SECRET=change-me-gateway-refresh
GATEWAY_AES_SECRET=change-me-gateway-aes
GATEWAY_ADMIN_INIT_PASSWORD=change-me-gateway-admin

# ── 业务侧调用 LLM 网关的 key（与 llm_gateway.gateway_api_key 表一致）──
LLM_GATEWAY_API_KEY_MAIN=lg-change-me-main
LLM_GATEWAY_API_KEY_AGENT=lg-change-me-agent

# ── 自动清理开关（全量数据版默认全关）────────────────────────────────
# MoonAgent 的归档会话清理/保留期清理会删 turn events、checkpoint、画布运行等派生数据；
# 交付要求是“所有数据都存在”，默认关闭。需要恢复时改成 true。
AI_ARCHIVE_CLEANUP_ENABLED=false
AI_RETENTION_ENABLED=false
STORYBOARD_TRASH_RETENTION_DAYS=30

# ── MoonSandbox（独立容器，默认开启）──────────────────────────────────
AGENT_SANDBOX_ENABLED=true
SANDBOX_INTERNAL_SECRET=change-me-sandbox
SANDBOX_ALLOWED_DOMAINS=.pypi.org .pythonhosted.org
SANDBOX_IMAGE_TAG=cloud-20261021

# ── 单 JVM 内存预算（2 核 2G）─────────────────────────────────────────
ALLINONE_MEM_LIMIT=1500m
ALLINONE_CPUS=2.0
JVM_XMX=768m
JVM_METASPACE=640m
JVM_CODE_CACHE=128m
JVM_EXTRA_OPTS=

# ── 其它容器资源上限 ───────────────────────────────────────────────────
POSTGRES_MEM_LIMIT=384m
POSTGRES_CPUS=1.0
REDIS_MEM_LIMIT=192m
REDIS_CPUS=0.5
MINIO_MEM_LIMIT=384m
MINIO_CPUS=0.5
FRONTEND_MEM_LIMIT=64m
FRONTEND_CPUS=0.5
SANDBOX_MEM_LIMIT=384m
SANDBOX_CPUS=1.0
SANDBOX_PROXY_MEM_LIMIT=192m
SANDBOX_PROXY_CPUS=0.25

TZ=Asia/Shanghai
