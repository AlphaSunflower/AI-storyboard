# Dify Media MCP Server 环境变量配置

# AI Storyboard 后端地址（Dify 容器内用 host.docker.internal，本地开发用 localhost）
DIFY_MEDIA_BACKEND_URL=http://host.docker.internal:8082

# Dify API Key — 与后端 ai.laozhang.dify-api-key 配置匹配
DIFY_MEDIA_API_KEY=your-dify-api-key-here

# 超时配置（秒）
DIFY_MEDIA_IMAGE_TIMEOUT=120
DIFY_MEDIA_VIDEO_CREATE_TIMEOUT=300
DIFY_MEDIA_VIDEO_POLL_INTERVAL=5
