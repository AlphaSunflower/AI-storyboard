# AI-storyboard 一体化部署栈配置示例
# 复制为 .env 后按目标机修改（.env 不入库）；所有 change-me-* 必须替换成真实值。
# 真实值取自原部署的 .env；db/*.dump 只存 llm_gateway.gateway_api_key.key_hash，
# 反推不出明文，恢复时 LLM_GATEWAY_API_KEY_* 必须沿用原部署明文，否则业务调用网关 401。
# 目标机最少只需改 PUBLIC_ORIGIN（以及端口冲突时的 FRONTEND_PORT）。

COMPOSE_PROJECT_NAME=aistoryboard
STACK_PREFIX=aistoryboard
IMAGE_TAG=stack-20261020
SANDBOX_IMAGE_TAG=stack-20261020

# ── 入口与端口 ──────────────────────────────────────────────────────────
FRONTEND_BIND_IP=0.0.0.0
FRONTEND_PORT=80
# 留空 = 起栈脚本自动取本机默认出口网卡的内网 IP；公网 IP / 域名请显式填写。
# 写死某一台机器的 IP 会让别的机器部署后画布写操作 403（Invalid CORS request）。
PUBLIC_ORIGIN=

POSTGRES_PORT=5433
REDIS_PORT=6379
GATEWAY_PORT=8083
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
SANDBOX_PORT=8090

# ── 服务发现：默认关闭，网关直连 ───────────────────────────────────────
NACOS_DISCOVERY_ENABLED=false
NACOS_ADDR=nacos:8848
BACKEND_URI=http://backend:8082
ASSET_SERVICE_URI=http://asset-service:8085
CANVAS_URI=http://canvas:9090
MOON_AGENT_URI=http://moon-agent:8084

# ── 数据库 ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-postgres

# ── 对象存储（必须与 data/minio 内已有凭据一致，勿改）──────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio

# ── 主后端 / 网关共享密钥 ──────────────────────────────────────────────
# 至少 32 字节（HS256 要求），每个部署各自生成，不要复用示例值。
INTERNAL_SECRET=change-me-internal-secret-0000000000
JWT_ACCESS_SECRET=change-me-jwt-access-0000000000
JWT_REFRESH_SECRET=change-me-jwt-refresh-0000000000
JWT_ISSUER=ai-storyboard-backend
AUTH_COOKIE_SECURE=false

# ── LLM 网关自举与加密 ─────────────────────────────────────────────────
GATEWAY_JWT_ACCESS_SECRET=change-me-gw-access-0000000000
GATEWAY_JWT_REFRESH_SECRET=change-me-gw-refresh-0000000000
GATEWAY_AES_SECRET=change-me-gateway-aes-0000000000
GATEWAY_ADMIN_INIT_PASSWORD=change-me-gateway-admin

# ── 业务侧调用网关的 key（必须与 llm_gateway.gateway_api_key 一致）────
LLM_GATEWAY_API_KEY_MAIN=lg-change-me-main-000000000000000000000000
LLM_GATEWAY_API_KEY_AGENT=lg-change-me-agent-00000000000000000000000

# ── Agent 联网检索（DeepSeek 原生搜索；留空 = 不注册该工具）──────────
AGENTSCOPE_WEB_SEARCH_API_KEY=
DEEPSEEK_API_KEY=

# ── 画布 MCP ───────────────────────────────────────────────────────────
MORROW_CANVAS_SERVER_URL=http://canvas:9090

# 媒体引用额外允许的 origin（默认空；仅 CDN/OSS 直供时需要）
MOON_MEDIA_ALLOWED_ORIGINS=

# ── Agent 沙箱 ─────────────────────────────────────────────────────────
AGENT_SANDBOX_ENABLED=true
SANDBOX_INTERNAL_SECRET=change-me-sandbox-0000000000
SANDBOX_ALLOWED_DOMAINS=.pypi.org .pythonhosted.org
SANDBOX_TMP_SIZE=512m

# ── 资源上限（JVM 堆跟随 mem_limit 的 75%）────────────────────────────
POSTGRES_MEM_LIMIT=512m
REDIS_MEM_LIMIT=256m
REDIS_MAXMEMORY=256mb
MINIO_MEM_LIMIT=512m
LLM_GATEWAY_MEM_LIMIT=512m
BACKEND_MEM_LIMIT=768m
ASSET_SERVICE_MEM_LIMIT=512m
CANVAS_MEM_LIMIT=768m
MOON_AGENT_MEM_LIMIT=1536m
API_GATEWAY_MEM_LIMIT=512m
FRONTEND_MEM_LIMIT=128m
SANDBOX_MEM_LIMIT=2g
SANDBOX_CPUS=2.0
SANDBOX_PROXY_MEM_LIMIT=256m

TZ=Asia/Shanghai
